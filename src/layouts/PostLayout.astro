---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { formatDateVi, getPostTaxonomy, slugifyTag, type BlogPost } from '@/utils/posts';

interface Props {
  post: BlogPost;
  headings: MarkdownHeading[];
  readingMinutes: number;
  prevPost?: BlogPost;
  nextPost?: BlogPost;
}

const { post, headings, readingMinutes, prevPost, nextPost } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const { category, subcategory } = getPostTaxonomy(post.id);
const hasToc = headings.some((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={title} description={description} ogType="article" wide={hasToc}>
  <div class:list={[hasToc ? 'xl:grid xl:grid-cols-[minmax(0,45rem)_18rem] xl:justify-center xl:gap-12' : 'mx-auto max-w-3xl']}>
    <article class="min-w-0">
      <header class="mb-8 border-b border-zinc-200/80 pb-6 dark:border-zinc-800/80">
        {
          category && (
            <nav aria-label="Danh mục bài viết" class="mb-3 flex flex-wrap items-center gap-1.5 text-xs font-medium text-zinc-500 dark:text-zinc-400">
              <a
                href={`/categories/${category.slug}`}
                class="rounded bg-zinc-100 px-2 py-0.5 text-zinc-700 transition-colors hover:bg-zinc-200 dark:bg-zinc-800/90 dark:text-zinc-300 dark:hover:bg-zinc-700"
              >
                {category.label}
              </a>
              {subcategory && (
                <>
                  <span aria-hidden="true">/</span>
                  <a
                    href={`/categories/${category.slug}/${subcategory.slug}`}
                    class="rounded bg-zinc-100 px-2 py-0.5 text-zinc-700 transition-colors hover:bg-zinc-200 dark:bg-zinc-800/90 dark:text-zinc-300 dark:hover:bg-zinc-700"
                  >
                    {subcategory.label}
                  </a>
                </>
              )}
            </nav>
          )
        }

        <div class="mb-3 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-zinc-500 dark:text-zinc-400">
          <time datetime={pubDate.toISOString()}>{formatDateVi(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingMinutes} phút đọc</span>
          {
            updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Cập nhật {formatDateVi(updatedDate)}</span>
              </>
            )
          }
        </div>

        <h1 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50">
          {title}
        </h1>

        <p class="mt-3 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
          {description}
        </p>

        {
          tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <a
                  href={`/tags/${slugifyTag(tag)}`}
                  class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-700 transition-colors hover:bg-zinc-200 dark:bg-zinc-800/90 dark:text-zinc-300 dark:hover:bg-zinc-700"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </header>

      <TableOfContents headings={headings} mode="mobile" />

      <div class="prose dark:prose-invert">
        <slot />
      </div>

      {
        (prevPost || nextPost) && (
          <nav
            aria-label="Điều hướng bài viết khác"
            class="mt-14 grid gap-4 border-t border-zinc-200/80 pt-8 sm:grid-cols-2 dark:border-zinc-800/80"
          >
            {prevPost ? (
              <a
                href={`/blog/${prevPost.id}`}
                class="group rounded-lg border border-zinc-200 p-4 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
              >
                <span class="text-xs text-zinc-500 dark:text-zinc-400">← Bài cũ hơn</span>
                <p class="mt-1 font-medium text-zinc-900 group-hover:underline dark:text-zinc-100">
                  {prevPost.data.title}
                </p>
              </a>
            ) : (
              <div />
            )}

            {nextPost && (
              <a
                href={`/blog/${nextPost.id}`}
                class="group rounded-lg border border-zinc-200 p-4 text-left transition-colors hover:border-zinc-400 sm:text-right dark:border-zinc-800 dark:hover:border-zinc-600"
              >
                <span class="text-xs text-zinc-500 dark:text-zinc-400">Bài mới hơn →</span>
                <p class="mt-1 font-medium text-zinc-900 group-hover:underline dark:text-zinc-100">
                  {nextPost.data.title}
                </p>
              </a>
            )}
          </nav>
        )
      }
    </article>

    {
      hasToc && (
        <aside class="hidden xl:block">
          <TableOfContents headings={headings} mode="desktop" />
        </aside>
      )
    }
  </div>

  <!-- Hộp phóng to & Zoom/Pan biểu đồ Mermaid -->
  <dialog
    id="mermaid-lightbox"
    aria-label="Xem phóng to biểu đồ"
    class="m-auto h-[92vh] w-[95vw] max-w-7xl rounded-xl border border-zinc-200 bg-white p-0 text-zinc-900 shadow-2xl backdrop:bg-black/75 backdrop:backdrop-blur-xs dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-100"
  >
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between border-b border-zinc-200 px-4 py-2.5 text-xs dark:border-zinc-800">
        <span class="font-medium text-zinc-600 dark:text-zinc-400">
          Lăn chuột để Zoom · Giữ chuột kéo để di chuyển · ESC để đóng
        </span>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            data-zoom="out"
            title="Thu nhỏ"
            class="cursor-pointer rounded border border-zinc-200 px-2.5 py-1 font-mono font-semibold hover:bg-zinc-100 dark:border-zinc-700 dark:hover:bg-zinc-800"
          >
            −
          </button>
          <span
            id="mermaid-zoom-level"
            class="min-w-12 text-center font-mono text-xs text-zinc-700 dark:text-zinc-300"
          >
            100%
          </span>
          <button
            type="button"
            data-zoom="in"
            title="Phóng to"
            class="cursor-pointer rounded border border-zinc-200 px-2.5 py-1 font-mono font-semibold hover:bg-zinc-100 dark:border-zinc-700 dark:hover:bg-zinc-800"
          >
            +
          </button>
          <button
            type="button"
            data-zoom="reset"
            class="cursor-pointer rounded border border-zinc-200 px-2.5 py-1 font-medium hover:bg-zinc-100 dark:border-zinc-700 dark:hover:bg-zinc-800"
          >
            1:1
          </button>
          <button
            type="button"
            data-zoom="close"
            aria-label="Đóng"
            class="ml-2 cursor-pointer rounded bg-zinc-900 px-3 py-1 font-medium text-white hover:opacity-90 dark:bg-zinc-100 dark:text-zinc-900"
          >
            Đóng ✕
          </button>
        </div>
      </div>

      <div
        id="mermaid-viewport"
        class="relative flex flex-1 cursor-grab items-center justify-center overflow-hidden bg-white select-none active:cursor-grabbing dark:bg-zinc-100"
      >
        <div id="mermaid-stage" class="origin-center transition-transform duration-75 ease-out"></div>
      </div>
    </div>
  </dialog>

  <script>
    // 1. Highlight mục đang đọc trên Mục lục (TOC Scroll-spy)
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (tocLinks.length > 0) {
      const linkMap = new Map(tocLinks.map((a) => [a.dataset.tocLink!, a]));
      const headingEls = tocLinks
        .map((a) => document.getElementById(a.dataset.tocLink!))
        .filter((el): el is HTMLElement => Boolean(el));

      let activeSlug = '';
      const setActive = (slug: string) => {
        if (!slug || slug === activeSlug) return;
        linkMap.get(activeSlug)?.classList.remove('toc-link-active');
        const next = linkMap.get(slug);
        if (next) {
          next.classList.add('toc-link-active');
          next.scrollIntoView({ block: 'nearest' });
          activeSlug = slug;
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              setActive(entry.target.id);
              break;
            }
          }
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
      );

      headingEls.forEach((el) => observer.observe(el));
    }

    // 2. Render Mermaid (khi có)
    const nodes = Array.from(document.querySelectorAll<HTMLElement>('pre.mermaid'));
    if (nodes.length > 0) {
      for (const el of nodes) {
        el.dataset.source = el.textContent ?? '';
      }

      const renderMermaid = async () => {
        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({
          startOnLoad: false,
          theme: 'neutral',
          fontFamily: 'Inter, system-ui, sans-serif',
        });

        for (const el of nodes) {
          el.removeAttribute('data-processed');
          el.textContent = el.dataset.source ?? '';
        }
        await mermaid.run({ nodes });
      };

      renderMermaid();
    }

    // 3. Hộp phóng to Lightbox (Zoom / Pan) dùng chung cho cả biểu đồ Mermaid và hình ảnh bài viết
    const dialog = document.getElementById('mermaid-lightbox') as HTMLDialogElement | null;
    const viewport = document.getElementById('mermaid-viewport');
    const stage = document.getElementById('mermaid-stage');
    const zoomLabel = document.getElementById('mermaid-zoom-level');

    if (dialog && viewport && stage && zoomLabel) {
      let scale = 1;
      let panX = 0;
      let panY = 0;
      let dragging = false;
      let startX = 0;
      let startY = 0;

      const applyTransform = () => {
        stage.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
        zoomLabel.textContent = `${Math.round(scale * 100)}%`;
      };

      const clampScale = (next: number) => Math.min(5, Math.max(0.35, next));

      const showInModal = (el: Node) => {
        stage.replaceChildren(el);
        scale = 1;
        panX = 0;
        panY = 0;
        applyTransform();
        dialog.showModal();
      };

      const openMermaid = (wrapper: HTMLElement) => {
        const svg = wrapper.querySelector('svg');
        if (!svg) return;
        const clone = svg.cloneNode(true) as SVGSVGElement;
        clone.id = `${svg.id || 'mermaid'}-modal`;

        const vb = svg.viewBox?.baseVal;
        const rawW = vb && vb.width > 0 ? vb.width : svg.getBoundingClientRect().width || 900;
        const rawH = vb && vb.height > 0 ? vb.height : svg.getBoundingClientRect().height || 600;
        const fitRatio = Math.min((window.innerWidth * 0.86) / rawW, (window.innerHeight * 0.76) / rawH, 1.4);

        clone.removeAttribute('style');
        clone.setAttribute('width', `${Math.round(rawW * fitRatio)}`);
        clone.setAttribute('height', `${Math.round(rawH * fitRatio)}`);
        showInModal(clone);
      };

      const openImage = (img: HTMLImageElement) => {
        const clone = document.createElement('img');
        clone.src = img.currentSrc || img.src;
        clone.alt = img.alt;
        clone.draggable = false;
        clone.className = 'max-h-[78vh] max-w-[86vw] object-contain rounded bg-white p-2';
        showInModal(clone);
      };

      document.querySelectorAll<HTMLElement>('.mermaid-wrapper').forEach((wrapper) => {
        wrapper.addEventListener('click', () => openMermaid(wrapper));
        wrapper.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openMermaid(wrapper);
          }
        });
      });

      document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
        img.addEventListener('click', () => openImage(img));
      });

      dialog.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target === dialog) {
          dialog.close();
          return;
        }
        const action = target.closest<HTMLElement>('[data-zoom]')?.dataset.zoom;
        if (!action) return;
        if (action === 'in') scale = clampScale(scale + 0.25);
        else if (action === 'out') scale = clampScale(scale - 0.25);
        else if (action === 'reset') {
          scale = 1;
          panX = 0;
          panY = 0;
        } else if (action === 'close') {
          dialog.close();
          return;
        }
        applyTransform();
      });

      viewport.addEventListener(
        'wheel',
        (e) => {
          e.preventDefault();
          const delta = e.deltaY < 0 ? 0.15 : -0.15;
          scale = clampScale(scale + delta);
          applyTransform();
        },
        { passive: false },
      );

      viewport.addEventListener('pointerdown', (e) => {
        dragging = true;
        startX = e.clientX - panX;
        startY = e.clientY - panY;
        stage.style.transition = 'none';
        viewport.setPointerCapture(e.pointerId);
      });

      viewport.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        panX = e.clientX - startX;
        panY = e.clientY - startY;
        applyTransform();
      });

      const endDrag = () => {
        dragging = false;
        stage.style.transition = '';
      };
      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);
    }
  </script>
</BaseLayout>
