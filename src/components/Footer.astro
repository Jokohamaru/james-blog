---
import { SITE } from '@/consts';
import { withBase } from '@/utils/posts';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-zinc-200/70 py-8 text-sm text-zinc-500 dark:border-zinc-800/70 dark:text-zinc-400">
  <div class="mx-auto flex max-w-3xl flex-col items-start justify-between gap-4 px-4 sm:flex-row sm:items-center sm:px-6">
    <p>© {year} {SITE.author}. Xây dựng với Astro.</p>
    <div class="flex items-center gap-4">
      <a
        href={SITE.socials.github}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-zinc-900 dark:hover:text-zinc-100"
      >
        GitHub
      </a>
      <a
        href={SITE.socials.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-zinc-900 dark:hover:text-zinc-100"
      >
        LinkedIn
      </a>
      <a href={withBase('rss.xml')} class="transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">
        RSS
      </a>
    </div>
  </div>
</footer>
