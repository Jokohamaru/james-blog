---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  mode?: 'mobile' | 'desktop';
}

const { headings, mode = 'desktop' } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  filtered.length > 0 && mode === 'mobile' && (
    <details class="mb-8 rounded-lg border border-zinc-200 bg-zinc-50/70 px-4 py-3 text-sm xl:hidden dark:border-zinc-800 dark:bg-zinc-900/50">
      <summary class="cursor-pointer font-medium text-zinc-900 select-none dark:text-zinc-100">
        Mục lục bài viết ({filtered.length})
      </summary>
      <ul class="mt-3 max-h-80 space-y-1.5 overflow-y-auto border-t border-zinc-200/80 pt-3 pr-2 dark:border-zinc-800">
        {filtered.map((h) => (
          <li class:list={[h.depth === 2 ? 'pt-2 first:pt-0' : 'pl-3.5']}>
            <a
              href={`#${h.slug}`}
              class:list={[
                'block rounded px-2 py-1 leading-relaxed transition-colors hover:bg-zinc-200/60 dark:hover:bg-zinc-800/70',
                h.depth === 2
                  ? 'font-medium text-zinc-800 dark:text-zinc-200'
                  : 'text-[13px] text-zinc-600 dark:text-zinc-400',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

{
  filtered.length > 0 && mode === 'desktop' && (
    <nav
      aria-label="Mục lục bài viết"
      class="toc-scroll sticky top-24 max-h-[calc(100vh-7.5rem)] overflow-y-auto pr-2"
    >
      <p class="mb-3 text-xs font-semibold tracking-wider text-zinc-400 uppercase dark:text-zinc-500">
        Mục lục
      </p>
      <ul class="space-y-1 border-l border-zinc-200/90 dark:border-zinc-800">
        {filtered.map((h) => (
          <li class:list={[h.depth === 2 && 'mt-2.5 first:mt-0']}>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class:list={[
                '-ml-px block border-l-2 border-transparent py-1.5 pr-2 leading-relaxed transition-colors hover:border-zinc-400 hover:text-zinc-900 dark:hover:border-zinc-500 dark:hover:text-zinc-100',
                h.depth === 2
                  ? 'pl-3.5 text-[13px] font-medium text-zinc-700 dark:text-zinc-300'
                  : 'pl-6 text-[12.5px] text-zinc-500 dark:text-zinc-400',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
