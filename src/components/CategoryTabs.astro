---
import { CATEGORIES } from '@/categories';
import type { BlogPost } from '@/utils/posts';
import { getPostTaxonomy, withBase } from '@/utils/posts';

interface Props {
  posts: BlogPost[];
  activeCategory?: string;
  activeSubcategory?: string;
}

const { posts, activeCategory, activeSubcategory } = Astro.props;

const catCounts = new Map<string, number>();
const subCounts = new Map<string, number>();

for (const post of posts) {
  const { category, subcategory } = getPostTaxonomy(post.id);
  if (category) {
    catCounts.set(category.slug, (catCounts.get(category.slug) ?? 0) + 1);
    if (subcategory) {
      const key = `${category.slug}/${subcategory.slug}`;
      subCounts.set(key, (subCounts.get(key) ?? 0) + 1);
    }
  }
}

const currentCat = CATEGORIES.find((c) => c.slug === activeCategory);
---

<div class="space-y-3">
  <nav aria-label="Danh mục chính" class="flex flex-wrap gap-2">
    <a
      href={withBase('blog')}
      class:list={[
        'inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-xs font-medium transition-colors',
        !activeCategory
          ? 'border-zinc-900 bg-zinc-900 text-white dark:border-zinc-100 dark:bg-zinc-100 dark:text-zinc-900'
          : 'border-zinc-200 bg-zinc-50 text-zinc-700 hover:border-zinc-400 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900/80 dark:text-zinc-300 dark:hover:border-zinc-600 dark:hover:text-zinc-100',
      ]}
    >
      <span>Tất cả</span>
      <span class:list={[!activeCategory ? 'text-zinc-300 dark:text-zinc-600' : 'text-zinc-400 dark:text-zinc-500']}>
        {posts.length}
      </span>
    </a>

    {
      CATEGORIES.map((cat) => {
        const isCurrent = activeCategory === cat.slug;
        const count = catCounts.get(cat.slug) ?? 0;
        return (
          <a
            href={withBase(`categories/${cat.slug}`)}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-xs font-medium transition-colors',
              isCurrent
                ? 'border-zinc-900 bg-zinc-900 text-white dark:border-zinc-100 dark:bg-zinc-100 dark:text-zinc-900'
                : 'border-zinc-200 bg-zinc-50 text-zinc-700 hover:border-zinc-400 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900/80 dark:text-zinc-300 dark:hover:border-zinc-600 dark:hover:text-zinc-100',
            ]}
          >
            <span>{cat.label}</span>
            <span class:list={[isCurrent ? 'text-zinc-300 dark:text-zinc-600' : 'text-zinc-400 dark:text-zinc-500']}>
              {count}
            </span>
          </a>
        );
      })
    }
  </nav>

  {
    currentCat && (
      <nav
        aria-label={`Nhánh con của ${currentCat.label}`}
        class="flex flex-wrap items-center gap-1.5 border-l-2 border-zinc-200 pl-3 dark:border-zinc-800"
      >
        <a
          href={withBase(`categories/${currentCat.slug}`)}
          class:list={[
            'rounded-full px-2.5 py-1 text-xs transition-colors',
            !activeSubcategory
              ? 'bg-zinc-200/80 font-medium text-zinc-900 dark:bg-zinc-800 dark:text-zinc-100'
              : 'text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100',
          ]}
        >
          Tất cả {currentCat.label} ({catCounts.get(currentCat.slug) ?? 0})
        </a>
        {currentCat.subcategories.map((sub) => {
          const isSubCurrent = activeSubcategory === sub.slug;
          const count = subCounts.get(`${currentCat.slug}/${sub.slug}`) ?? 0;
          return (
            <a
              href={withBase(`categories/${currentCat.slug}/${sub.slug}`)}
              class:list={[
                'rounded-full px-2.5 py-1 text-xs transition-colors',
                isSubCurrent
                  ? 'bg-zinc-200/80 font-medium text-zinc-900 dark:bg-zinc-800 dark:text-zinc-100'
                  : 'text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100',
              ]}
            >
              {sub.label} ({count})
            </a>
          );
        })}
      </nav>
    )
  }
</div>
