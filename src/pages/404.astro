---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/utils/posts';
---

<BaseLayout title="404 — Không tìm thấy trang">
  <div class="py-16 text-center">
    <p class="font-mono text-sm font-medium text-zinc-400 dark:text-zinc-500">404</p>
    <h1 class="mt-2 text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
      Không tìm thấy trang yêu cầu
    </h1>
    <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
      Đường dẫn có thể đã thay đổi hoặc bài viết không tồn tại.
    </p>
    <a
      href={withBase()}
      class="mt-6 inline-flex items-center rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90 dark:bg-zinc-100 dark:text-zinc-900"
    >
      Quay về trang chủ
    </a>
  </div>
</BaseLayout>
