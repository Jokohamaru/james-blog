---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDateVi, getPublishedPosts, slugifyTag, withBase, type BlogPost } from '@/utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tagMap = new Map<string, { label: string; posts: BlogPost[] }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTag(tag);
      const entry = tagMap.get(slug) ?? { label: tag, posts: [] };
      entry.posts.push(post);
      tagMap.set(slug, entry);
    }
  }

  return Array.from(tagMap.entries()).map(([tag, { label, posts }]) => ({
    params: { tag },
    props: { label, posts },
  }));
}

interface Props {
  label: string;
  posts: BlogPost[];
}

const { label, posts } = Astro.props;
---

<BaseLayout title={`Chủ đề #${label}`} description={`Các bài viết gắn thẻ #${label}`}>
  <header class="mb-10">
    <a
      href={withBase('blog')}
      class="text-sm text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      ← Tất cả bài viết
    </a>
    <h1 class="mt-3 text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50">
      #{label}
    </h1>
    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
      {posts.length} bài viết thuộc chủ đề này.
    </p>
  </header>

  <ul class="divide-y divide-zinc-200/70 dark:divide-zinc-800/70">
    {
      posts.map((post) => (
        <li class="py-5 first:pt-0">
          <a href={withBase(`blog/${post.id}`)} class="group block">
            <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline sm:gap-4">
              <h2 class="font-medium text-zinc-900 group-hover:underline dark:text-zinc-100">
                {post.data.title}
              </h2>
              <time
                datetime={post.data.pubDate.toISOString()}
                class="shrink-0 font-mono text-xs text-zinc-500 dark:text-zinc-400"
              >
                {formatDateVi(post.data.pubDate)}
              </time>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {post.data.description}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
